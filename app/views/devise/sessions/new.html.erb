<div class="min-h-screen bg-slate-900 flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-white rounded-lg shadow-lg p-8">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Cadence</h1>
      <p class="text-gray-600">Sign in to your account</p>
    </div>

    <%= form_for(resource, as: resource_name, local: true, url: session_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-6">
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition" %>
      </div>

      <div class="mb-6">
        <%= f.label :password, "Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", class: "w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-6 flex items-center">
          <%= f.check_box :remember_me, {class: "h-4 w-4 text-blue-500 focus:ring-blue-500 border-gray-300 rounded"} %>
          <%= f.label :remember_me, "Remember me", class: "ml-2 block text-sm text-gray-600" %>
        </div>
      <% end %>

      <div class="mb-6">
        <%= f.submit "Sign in", class: "w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-3 rounded-lg transition" %>
      </div>

      <div class="text-center space-y-2 text-sm">
        <div>
          <%= link_to "Sign up", new_registration_path(resource_name), class: "text-gray-700 hover:text-gray-900 font-medium" %>
        </div>
        <div>
          <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-gray-700 hover:text-gray-900" %>
        </div>
        <% if devise_mapping.confirmable? && resource_class.confirm_by_pending_reconfirmation? %>
          <div>
            <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), class: "text-gray-700 hover:text-gray-900" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
