<%= turbo_frame_tag "check_in_board", class: "mx-auto block max-w-3xl space-y-8 px-6 py-10", data: { controller: "refresh", refresh_interval_value: 15000 } do %>
  <header>
    <p class="text-sm font-medium uppercase tracking-wider text-teal-700">A little movement, a better rhythm</p>
    <h1 class="mt-2 text-3xl font-bold">Your next small step</h1>
    <p class="mt-3 text-slate-600">Choose a rhythm. Move when you can. Tell Cadence what happened.</p>
  </header>

  <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">
    This first web build saves your schedule and answers. Automatic speech and hands-free replies while your phone is locked still need the Android device test.
  </div>

  <% if @pending.any? %>
    <section aria-labelledby="check-in-heading" class="space-y-4">
      <h2 id="check-in-heading" class="text-xl font-semibold">Time to check in</h2>
      <% @pending.each do |check_in| %>
        <article class="rounded-2xl border border-teal-200 bg-white p-6 shadow-sm" data-controller="speech" data-speech-message-value="Ready to <%= check_in.commitment.title.downcase %>?">
          <h3 class="text-xl font-semibold"><%= check_in.commitment.title %></h3>
          <p class="mt-2 text-slate-600">Ready for a movement break?</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <%= button_to "Done", check_in_path(check_in), method: :patch, form: { data: { turbo_frame: "_top" } }, params: { answer: "done" }, class: "rounded-lg bg-teal-700 px-5 py-3 font-medium text-white" %>
            <%= button_to "Later · 5 minutes", check_in_path(check_in), method: :patch, form: { data: { turbo_frame: "_top" } }, params: { answer: "later" }, class: "rounded-lg border border-slate-300 px-5 py-3 font-medium" %>
            <%= button_to "Skip", check_in_path(check_in), method: :patch, form: { data: { turbo_frame: "_top" } }, params: { answer: "skip" }, class: "rounded-lg border border-slate-300 px-5 py-3 font-medium" %>
          </div>
          <button type="button" data-action="speech#speak" class="mt-4 text-sm font-medium text-teal-800 underline">Preview spoken prompt</button>
          <p data-speech-target="status" class="mt-2 text-sm text-slate-500" role="status">Preview plays only after a tap in a supported browser.</p>
        </article>
      <% end %>
    </section>
  <% else %>
    <p class="rounded-2xl bg-white p-6 text-slate-600 shadow-sm">No check-in is waiting. Your next one will appear here when it’s due.</p>
  <% end %>

  <section aria-labelledby="schedule-heading" class="space-y-4">
    <h2 id="schedule-heading" class="text-xl font-semibold">Your rhythm</h2>
    <% @commitments.each do |commitment| %>
      <article class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-5">
        <div>
          <h3 class="font-semibold"><%= commitment.title %></h3>
          <p class="mt-1 text-sm text-slate-600">Every <%= pluralize(commitment.interval_minutes, "minute") %> · <%= commitment.active? ? "Active" : "Paused" %></p>
          <% if commitment.active? %>
            <% open_check_in = commitment.check_ins.where(status: %w[pending snoozed]).first %>
            <p class="mt-1 text-sm text-slate-500">
              <% if open_check_in&.pending? %>
                Waiting for your answer
              <% else %>
                Next check-in: <time datetime="<%= commitment.next_due_at.iso8601 %>" data-controller="local-time"><%= commitment.next_due_at.strftime("%b %-d, %H:%M UTC") %></time>
              <% end %>
            </p>
          <% end %>
        </div>
        <div class="flex gap-4 text-sm font-medium text-teal-800">
          <% if commitment.active? %>
            <%= button_to "Check in now", commitment_path(commitment), method: :patch, form: { data: { turbo_frame: "_top" } }, params: { operation: "check_now" }, class: "underline" %>
          <% end %>
          <%= button_to commitment.active? ? "Pause" : "Resume", commitment_path(commitment), method: :patch, form: { data: { turbo_frame: "_top" } }, params: { operation: commitment.active? ? "pause" : "resume" }, class: "underline" %>
        </div>
      </article>
    <% end %>

    <%= form_with model: @commitment, data: { turbo_frame: "_top" }, class: "space-y-4 rounded-2xl border border-slate-200 bg-white p-6" do |form| %>
      <h3 class="font-semibold">Add a movement commitment</h3>
      <div>
        <%= form.label :title, "What would you like to do?", class: "block text-sm font-medium" %>
        <%= form.text_field :title, required: true, maxlength: 120, class: "mt-2 w-full rounded-lg border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :interval_minutes, "Check in every (minutes)", class: "block text-sm font-medium" %>
        <%= form.number_field :interval_minutes, min: 1, max: 1440, required: true, class: "mt-2 w-32 rounded-lg border border-slate-300 px-3 py-2" %>
      </div>
      <%= form.submit "Set my rhythm", class: "cursor-pointer rounded-lg bg-teal-700 px-5 py-3 font-medium text-white" %>
    <% end %>
  </section>

  <% if @history.any? %>
    <section aria-labelledby="history-heading">
      <h2 id="history-heading" class="mb-4 text-xl font-semibold">Recent check-ins</h2>
      <ul class="divide-y divide-slate-200 rounded-2xl bg-white px-5">
        <% @history.each do |check_in| %>
          <li class="flex justify-between gap-4 py-4">
            <span><%= check_in.commitment.title %></span>
            <span class="text-sm text-slate-600"><%= check_in.status.humanize %> · <time datetime="<%= check_in.updated_at.iso8601 %>" data-controller="local-time"><%= check_in.updated_at.strftime("%b %-d, %H:%M UTC") %></time></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
