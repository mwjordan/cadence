<div class="min-h-screen bg-slate-50">
  <div class="mx-auto flex min-h-screen max-w-2xl items-center justify-center px-6">
    <div class="w-full rounded-2xl bg-white p-10 shadow-sm ring-1 ring-slate-200">
      <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">App Setup</h1>
        <p class="mt-2 text-slate-600">
          Rename your application. This will update the Ruby module name, database names,
          config files, and page titles.
        </p>
      </div>

      <div class="mb-6 rounded-lg bg-slate-50 p-4">
        <p class="text-sm text-slate-500">Current app name</p>
        <p class="text-lg font-semibold text-slate-900"><%= @current_name %></p>
      </div>

      <%= form_with url: setup_path, method: :patch, class: "space-y-6" do |f| %>
        <div>
          <label for="app_name" class="block text-sm font-medium text-slate-700">New app name</label>
          <input
            type="text"
            name="app_name"
            id="app_name"
            placeholder="e.g. My Cool App"
            required
            autofocus
            class="mt-1 block w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
          />
          <p class="mt-1.5 text-xs text-slate-500">
            Letters, numbers, spaces, hyphens, and underscores allowed. Must start with a letter.
          </p>
        </div>

        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
          <div class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.168 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 6a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 6zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
            </svg>
            <div class="text-sm text-amber-800">
              <p class="font-medium">This will modify files on disk</p>
              <p class="mt-1">The rename updates <code class="rounded bg-amber-100 px-1">config/application.rb</code>,
              <code class="rounded bg-amber-100 px-1">config/database.yml</code>,
              <code class="rounded bg-amber-100 px-1">config/deploy.yml</code>,
              <code class="rounded bg-amber-100 px-1">Dockerfile</code>,
              layout, and PWA manifest.
              It will also attempt to rename your PostgreSQL databases.
              You'll need to restart the server after renaming.</p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-4">
          <%= link_to "Cancel", root_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
          <button type="submit" class="rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20">
            Rename App
          </button>
        </div>
      <% end %>

      <div class="mt-8 border-t border-slate-200 pt-6">
        <h2 class="text-sm font-semibold text-slate-700">What gets renamed</h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex gap-2">
            <dt class="font-medium text-slate-500 w-32">Ruby module:</dt>
            <dd class="text-slate-700"><code>RailsAppStarterKit</code> → <code class="text-indigo-600">YourAppName</code></dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-slate-500 w-32">Database:</dt>
            <dd class="text-slate-700"><code>rails_app_starter_kit_development</code> → <code class="text-indigo-600">your_app_name_development</code></dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-slate-500 w-32">Docker image:</dt>
            <dd class="text-slate-700"><code>rails_app_starter_kit</code> → <code class="text-indigo-600">your_app_name</code></dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-slate-500 w-32">Page title:</dt>
            <dd class="text-slate-700"><code>Rails App Starter Kit</code> → <code class="text-indigo-600">Your App Name</code></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>
